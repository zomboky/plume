{
  "name": "plume",
  "productName": "Plume",
  "version": "0.1.0",
  "description": "Éditeur Markdown WYSIWYG pour Windows",
  "author": "Plume contributors",
  "license": "MIT",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:e2e": "electron-vite build && playwright test",
    "icon": "node scripts/make-icon.mjs",
    "build:win": "electron-vite build && electron-builder --win nsis portable --x64"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@milkdown/kit": "7.23.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "fuse.js": "^7.5.0",
    "happy-dom": "^21.0.4",
    "katex": "^0.19.1",
    "mermaid": "^12.2.0",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "typescript": "~5.9.3",
    "unified": "^11.0.5",
    "vite": "^7.3.7",
    "vitest": "^5.0.5"
  }
}
